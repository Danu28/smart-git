{
  "name": "smart-git",
  "version": "2.0.0",
  "description": "smart-git \u00e2\u20ac\u201d a smarter, safer, more intuitive CLI wrapper that improves git with interactive workflows, conventional commits, safe sync and cleanup",
  "main": "src/index.js",
  "bin": {
    "smart-git": "./bin/smart-git.js",
    "sg": "./bin/smart-git.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Danu28/smart-git.git"
  },
  "homepage": "https://github.com/Danu28/smart-git#readme",
  "bugs": {
    "url": "https://github.com/Danu28/smart-git/issues"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --check-coverage --lines 60 --branches 50 --functions 55 --statements 60 node --test",
    "test:coverage:ci": "c8 --reporter=text --reporter=lcov node --test",
    "test:coverage:report": "c8 --reporter=text --reporter=lcov --check-coverage --lines 60 --branches 50 node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \".**/*.{js,json,md,yml}\"",
    "format:check": "prettier --check \".**/*.{js,json,md,yml}\"",
    "start": "node bin/smart-git.js --help"
  },
  "keywords": [
    "git",
    "cli",
    "smart-git",
    "sg",
    "developer-tools",
    "conventional-commits",
    "productivity",
    "git-wrapper"
  ],
  "author": "Danu28 <dhanushkanchan28@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "inquirer": "^8.2.5"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
